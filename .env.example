# Copy to .env for local development (scripts/dev-env.mjs fills in the secrets).
# Never commit real secrets (rules 10.5). Append new variables alphabetically within their section.

# Runtime
# DOCS_ENABLED=true   # Swagger UI at /docs (default: on outside production)
LOG_LEVEL=info
NODE_ENV=development
PORT=3001

# URLs
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
# The staff app (E-31, E-35): staff sign-in links open here; add it to CORS_ORIGINS too.
STAFF_APP_URL=
# The staff app's Owner (E-64): only while no Owner exists, this account becomes the Owner and an
# admin (a new account if needed). Later changes are made in the app (handover) or, to recover,
# with `pnpm --filter @figcit/api staff:owner -- --email <email> --reason "<why>"`.
OWNER_EMAIL=
# Pinged every 14 minutes so a host that sleeps when idle stays up (the API's own /v1/health).
KEEP_ALIVE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (docker/compose.dev.yml or a local Postgres)
DATABASE_URL=postgresql://figcit:figcit@localhost:5432/figcit

# Auth (Ed25519 PEM, base64; generated by scripts/dev-env.mjs)
ACCESS_TTL_SECONDS=900
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_PRIVATE_KEY=<generated>
JWT_PUBLIC_KEY=<generated>
REFRESH_TTL_DAYS=30
STAFF_SESSION_HOURS=8

# Encryption: "<version>:<32 bytes base64>[,…]" (SOPS + age in production)
MASTER_KEYS=<generated>

# Jobs: true runs them in the API process with no polling, so an idle database can sleep (ADR 0010)
JOBS_ON_DEMAND=false

# Email: leave SMTP_URL empty locally; DEV_MAILBOX exposes GET /v1/dev/mailbox
# BREVO_API_KEY sends through Brevo's HTTPS API (wins over SMTP_URL), for hosts that block SMTP
BREVO_API_KEY=
DEV_MAILBOX=true
MAIL_FROM=FigCit <hello@figcit.co.uk>
SMTP_URL=

# Storage: local disk in development, S3-compatible (SeaweedFS) in production
S3_ACCESS_KEY=
S3_BUCKET=figcit-private
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_SECRET_KEY=
STORAGE_DIR=var/storage
STORAGE_DRIVER=local

# AI and speech (optional, every task has a fallback). Our own llama.cpp / whisper.cpp by default;
# for a hosted OpenAI-style API set AI_PROVIDER=openai and SPEECH_PROVIDER=openai, e.g. Groq:
#   AI_BASE_URL=https://api.groq.com/openai  AI_MODEL=qwen/qwen3.8-27b  AI_REASONING_EFFORT=none
#   WHISPER_URL=https://api.groq.com/openai  SPEECH_MODEL=whisper-large-v3-turbo
AI_PROVIDER=llama
AI_BASE_URL=
AI_TOKEN=
AI_MODEL=ministral-3-3b-instruct-q4_k_m
AI_TIMEOUT_MS=8000
ASSIST_DAILY_ALLOWANCE=10
WHISPER_URL=
SPEECH_PROVIDER=whisper
SPEECH_MODEL=whisper-large-v3-turbo
SPEECH_TOKEN=

# Push (generated by scripts/dev-env.mjs)
VAPID_PRIVATE_KEY=<generated>
VAPID_PUBLIC_KEY=<generated>
VAPID_SUBJECT=mailto:hello@figcit.co.uk

# Billing (fake provider until D-14 is decided)
BILLING_PROVIDER=fake
BILLING_WEBHOOK_SECRET=dev-webhook-secret

# Abuse protection
RATE_LIMIT_ENABLED=true

# Guest spaces (docs/GUEST_SPACE.md): sign-ups per network address per hour and per day, and in all
# per day. The bot challenge is off; to use one, set the siteverify URL and secret of Turnstile,
# hCaptcha or reCAPTCHA and GUEST_BOT_CHALLENGE=true.
GUEST_BOT_CHALLENGE=false
GUEST_BOT_SECRET=
GUEST_BOT_VERIFY_URL=
GUEST_DAILY_CAP=2000
GUEST_SIGNUPS_PER_DAY=20
GUEST_SIGNUPS_PER_HOUR=5

# Errors (GlitchTip DSN)
SENTRY_DSN=
