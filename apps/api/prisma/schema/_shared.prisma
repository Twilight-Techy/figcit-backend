// Multi-file schema: one file per module (WORKFLOW §3). Edit only your module's file.
// Conventions (ENGINEERING_RULES §5.3):
// - ids are UUIDv7 (time-ordered), generated by the client for anything created offline;
// - times are timestamptz(3); scales and ratings are smallint;
// - tables and columns are snake_case via @@map/@map;
// - fields ending in `Enc` are AES-256-GCM ciphertext (bytea) under the owner's data key
//   (common/crypto); the blob header carries the key version;
// - user-owned rows cascade from users, so a hard delete removes everything.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The eight support pathways (workbook readme). Never NUCRIPCE drivers.
enum Pathway {
  regulate
  dump
  express
  execute
  adapt
  reflect
  connect
  meditate

  @@map("pathway")
}

// Final light shown on the card (workbook Tab 10).
enum Light {
  green
  yellow
  amber
  red
  blue

  @@map("light")
}

// Timeline codes (workbook Tab 4).
enum TimelineCode {
  T0
  T1
  T2
  T3
  T4
  T5
  T6
  TX
  TR

  @@map("timeline_code")
}

// Where a record was produced: by the server, or on the device while offline / in Browse mode.
enum Origin {
  online
  offline

  @@map("origin")
}
