// Append-only audit log of sensitive reads, shares, config changes and staff actions.
// A trigger (migration SQL) rejects UPDATE and DELETE.
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(32)
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String?  @map("target_id") @db.VarChar(64)
  reason     String?  @db.VarChar(200)
  meta       Json?    // codes only, never personal text
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@index([at])
  @@map("audit_events")
}
