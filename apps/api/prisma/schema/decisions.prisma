// Engine v2 decision records (docs/engine-v2/DESIGN.md §7, DECISION_LOG E-13, E-52): one per card
// the engine made, holding everything needed to replay it. Append-only: a trigger in the migration
// refuses changes to anything but the replay outcome. Not encrypted at this stage (E-13).

enum DecisionMode {
  signed_in
  browse

  @@map("decision_mode")
}

model DecisionRecord {
  id            String         @id @default(uuid(7)) @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  mode          DecisionMode
  // The account; null for Browse (E-05). Plain ID, as in the rule store (no cross-module relation).
  userId        String?        @map("user_id") @db.Uuid
  versionId     String         @map("version_id") @db.Uuid
  version       RulesetVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  // The published version's hash and the engine's version: what replay must reproduce.
  rulesetHash   String         @map("ruleset_hash") @db.Char(64)
  engineVersion String         @map("engine_version") @db.VarChar(20)
  // The engine's input facts: standard values only, never free text (E-04, E-13).
  input         Json
  card          Json
  // The light trace: the rules that fired and the run's notes. The full trace is rebuilt by
  // replay (E-21, E-57), which keeps a record under 4 KB (ENGINEERING_RULES §1.3).
  trace         Json
  band          String?        @db.VarChar(32)
  light         String?        @db.VarChar(16)
  supportScreen Boolean        @map("support_screen")
  // The decision this one re-checks (Tab 8 step 11).
  recheckOfId   String?        @map("recheck_of_id") @db.Uuid
  replayedAt    DateTime?      @map("replayed_at") @db.Timestamptz(3)
  replayMatches Boolean?       @map("replay_matches")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([versionId])
  @@map("decision_records")
}

enum ExplorationKind {
  explore
  compare
  impact

  @@map("exploration_kind")
}

enum ExplorationStatus {
  queued
  running
  done
  failed

  @@map("exploration_status")
}

// A staff explorer run (M7, DESIGN §8, E-57): the API queues it, the worker runs it off the
// API's event loop (ENGINEERING_RULES §6), the staff app polls for the result. Kept 7 days.
model EngineExploration {
  id          String            @id @default(uuid(7)) @db.Uuid
  kind        ExplorationKind
  status      ExplorationStatus @default(queued)
  label       String            @db.VarChar(40)
  // The request as sent: the input set, query, version compared against or rule. Codes only.
  request     Json
  result      Json?
  error       String?           @db.VarChar(500)
  requestedBy String            @map("requested_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt   DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?         @map("finished_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("engine_explorations")
}

/// A Simulator scenario (E-61): a check-in staff saved to play again on any version, shared by
/// the staff who can use the Simulator. Made-up answers for testing, never a user's.
model SimScenario {
  id        String           @id @default(uuid(7)) @db.Uuid
  name      String           @db.VarChar(120)
  // The Simulator's answers, to show its screens as they were (the staff app's own shape).
  answers   Json
  // What it runs: the check-in as the app sends it, and what the server adds.
  request   Json
  createdBy String           @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  runs      SimScenarioRun[]

  @@index([createdAt])
  @@map("sim_scenarios")
}

/// One run of a scenario: the version it ran on, who ran it, and the card it gave then.
model SimScenarioRun {
  id         String      @id @default(uuid(7)) @db.Uuid
  scenarioId String      @map("scenario_id") @db.Uuid
  scenario   SimScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  // The label is kept as well: a discarded draft's runs still say what they ran on.
  versionId  String      @map("version_id") @db.Uuid
  label      String      @db.VarChar(40)
  ranBy      String      @map("ran_by") @db.Uuid
  ranAt      DateTime    @default(now()) @map("ran_at") @db.Timestamptz(3)
  // The light, band, card kind, main suggestion and alternatives: codes and labels only.
  outcome    Json

  @@index([scenarioId, ranAt])
  @@map("sim_scenario_runs")
}
