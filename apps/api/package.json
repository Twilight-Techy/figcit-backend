{
  "name": "@figcit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "node --conditions=development --watch-path=src --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --conditions=development --watch-path=src --import @swc-node/register/esm-register src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migration": "prisma migrate dev --create-only --name",
    "openapi:generate": "echo 'OpenAPI generation arrives with backend issue #6' && exit 1",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@figcit/engine": "workspace:*",
    "@figcit/rules-compiler": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "argon2": "0.45.1",
    "fastify": "5.11.3",
    "jose": "6.2.13",
    "minio": "8.0.7",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/nodemailer": "8.0.2",
    "@types/web-push": "3.6.4",
    "prisma": "^6.19.3",
    "unplugin-swc": "2.0.0"
  }
}
