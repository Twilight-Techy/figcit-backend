{
  "name": "@figcit/rules-compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Reads the rules workbook (.xlsx) and writes the snapshot JSON and engine fixtures.",
  "type": "module",
  "bin": {
    "figcit-rules": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "fixtures:generate": "tsx --conditions=development src/cli.ts fixtures",
    "snapshot:generate": "tsx --conditions=development src/cli.ts snapshot"
  },
  "devDependencies": {
    "@figcit/engine": "workspace:*",
    "tsx": "4.23.15"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  }
}
