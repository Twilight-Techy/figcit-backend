{
  "name": "@figcit/engine",
  "version": "1.1.2",
  "description": "NUCCESS decision engine: pure, dependency-free, runs in Node and browsers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./snapshot.json": "./fixtures/snapshot.json"
  },
  "files": [
    "dist",
    "fixtures/snapshot.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./snapshot.json": "./fixtures/snapshot.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest run test/budget.test.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2"
  }
}
